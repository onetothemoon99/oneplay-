# OnePlay — environment variables
# Copy this file to .env.local for local dev, or set the same keys in your
# deploy platform's environment settings (Vercel/etc). Never commit the
# real .env.local — it's already in .gitignore.

# --- Supabase (required) ---
# Dashboard → Project Settings → Data API. The publishable key is safe to
# expose to the browser (NEXT_PUBLIC_*) — it's what RLS is for.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Drive import (optional) ---
# Lets players pick a disc image out of their own Google Drive on /play/psx.
# Leave unset and the app runs fine — isDriveConfigured() hides the feature
# when any of these three are missing. See README.md "Google Drive import".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_GOOGLE_APP_ID=xxxxxxxxxxxx

# --- Local tooling only, not read by the app at runtime ---
# Only needed on a machine that runs `supabase db query --file ...` to apply
# supabase/migrations/*.sql by hand (Dashboard → Project Settings → Database
# → Connection string → Session pooler). Do NOT set this on the deploy
# platform — the deployed app never touches Postgres directly, only through
# the Supabase client above.
# SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-X-<region>.pooler.supabase.com:5432/postgres
